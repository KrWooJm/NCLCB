# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.

# 한국투자증권 실전 앱키 — 시세·순위 조회 전용.
# 이 키를 쓰는 클라이언트는 시세 외 경로(주문·잔고)를 코드에서 거부한다.
KIS_QUOTE_APP_KEY=
KIS_QUOTE_APP_SECRET=

# 한국투자증권 모의투자 앱키·계좌 — 6단계(PaperExecutor)부터 사용
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# 텔레그램 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
